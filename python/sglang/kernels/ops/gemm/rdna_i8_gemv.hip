          const int8_t* wb = reinterpret_cast<const int8_t*>(&wv);
          #pragma unroll
          for (int j = 0; j < 16; ++j) {
            float w = (float)wb[j];
            acc[mp][r] += w * xa[j];
            acc[mp + 1][r] += w * xb[j];
